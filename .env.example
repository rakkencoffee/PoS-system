# ─── Next.js ───
NEXT_PUBLIC_BASE_URL=http://localhost:3000
AUTH_SECRET=""

# ─── PostgreSQL Database ───
DATABASE_URL="postgresql://username:password@host:port/dbname?sslmode=require"
DIRECT_DATABASE_URL="postgresql://username:password@host:port/dbname?sslmode=require"

# ─── Upstash Redis ───
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Upstash QStash ───
QSTASH_URL=""
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# ─── Pusher ───
PUSHER_APP_ID=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# ─── Olsera API ───
USE_OLSERA=true
OLSERA_API_BASE=https://api-open.olsera.co.id
OLSERA_APP_ID=""
OLSERA_SECRET_KEY=""
OLSERA_STORE_ID=""
OLSERA_STORE_ALIAS=""
# Customer Type "Member" dibuat manual di Olsera Dashboard (Pelanggan & Supplier
# > Tipe Pelanggan) — pisahin member Member App dari guest kiosk (tipe "Guest", id 0)
OLSERA_MEMBER_CUSTOMER_TYPE_ID=""

# ─── Print Bridge (Local Thermal Printer) ───
NEXT_PUBLIC_PRINT_BRIDGE_URL=http://localhost:3001
NEXT_PUBLIC_PRINT_BRIDGE_API_KEY=""
CLOUD_API_URL=""
CLOUD_POLLING_INTERVAL=3000

# ─── Olsera Webhook Security ───
OLSERA_WEBHOOK_SECRET=""

# ─── EDC Bridge (Local Ingenico Axium DX8000, edc-bridge/ daemon) ───
EDC_BRIDGE_API_KEY=""

# ─── Member App (loyalty, server-to-server only — see docs/reference/LOYALTY-MEMBER-APP.md) ───
MEMBER_APP_API_KEY=""
