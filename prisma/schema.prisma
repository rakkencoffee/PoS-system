generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id               String     @id @default(cuid())
  username         String     @unique
  name             String
  passwordHash     String
  role             Role       @default(CASHIER)
  defaultStationId String?
  createdAt        DateTime   @default(now())
  orders           Order[]
  shiftLogs        ShiftLog[]
}

model Order {
  id                  String           @id
  stationId           String
  printStation        String? // A/B/C — tablet asal order, buat routing print job ke printer yang benar
  cashierId           String
  tableNumber         String?
  queueNumber         Int? // Daily queue number (001, 002, ...) resets at 00:00 WIB
  status              OrderStatus      @default(PENDING)
  baristaStatus       OrderStatus      @default(PENDING)
  kitchenStatus       OrderStatus      @default(PENDING)
  total               Int
  paymentMethod       String?
  cashReceived        Int?
  changeAmount        Int?
  edcTransactionId    String?
  olseraSynced        Boolean          @default(false)
  olseraSyncedAt      DateTime?
  olseraTransactionId String?
  channel             OrderChannel     @default(KIOSK) // KIOSK (existing) vs MEMBER_APP (loyalty, lihat PRD Bab 3)
  memberId            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  cashier             User             @relation(fields: [cashierId], references: [id])
  member              Member?          @relation(fields: [memberId], references: [id])
  items               OrderItem[]
  statusLogs          OrderStatusLog[]
  pointLedgerEntries  PointLedger[]
  edcJobs             EdcJob[]

  @@index([stationId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([olseraSynced])
  @@index([memberId])
  @@index([channel])
}

// Jurnal/audit trail setiap perubahan status order (order/barista/kitchen),
// mencatat sumber perubahan supaya bisa ditelusuri kapan/dari mana/kenapa.
model OrderStatusLog {
  id          String   @id @default(cuid())
  orderId     String
  statusField String // "order" | "barista" | "kitchen"
  fromStatus  String? // null = entri pertama (order baru dibuat)
  toStatus    String
  source      String // order_created | midtrans_webhook | midtrans_manual_verify |
  // system_voucher_100 | olsera_settlement | kds_manual |
  // olsera_webhook | system_recovery
  actorId     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@index([orderId, statusField])
  @@index([source])
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  olseraId String
  name     String
  price    Int
  quantity Int
  subtotal Int
  notes    String?
  order    Order   @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model ShiftLog {
  id          String    @id @default(cuid())
  stationId   String
  cashierId   String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  openingCash Int       @default(0)
  closingCash Int?
  totalSales  Int?
  cashier     User      @relation(fields: [cashierId], references: [id])

  @@index([stationId, startTime])
}

model ProductCache {
  olseraId    String   @id
  name        String
  description String?
  price       Int
  stock       Int
  category    String
  imageUrl    String?
  isActive    Boolean  @default(true)
  cachedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([cachedAt])
}

model OlseraSyncLog {
  id          String   @id @default(cuid())
  type        String
  status      String
  orderId     String?
  productId   String?
  itemsSynced Int?
  errorMsg    String?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([status])
}

enum Role {
  CASHIER
  MANAGER
  KITCHEN
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

// Cloud Print Queue — struk dikirim dari tablet via cloud, ditarik oleh daemon lokal
model PrintJob {
  id           String   @id @default(cuid())
  orderId      String   @unique // one print job per order, ever — enforces the dedup that both create paths (client checkout, server settlement) only check advisorily
  payload      Json // PrintReceiptData (orderId, items, total, dll)
  status       String   @default("PENDING") // PENDING, PRINTING, PRINTED, FAILED
  station      String? // A/B/C — dipakai print-bridge buat routing ke printer yang benar
  attempts     Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Cloud EDC Payment Queue — job dibuat saat checkout pilih "Bayar Kartu EDC", ditarik &
// diproses oleh daemon lokal yang USB-connect ke terminal Ingenico fisik (lihat edc-bridge/),
// hasil (approved/rejected) dilaporkan balik lewat PATCH. Beda dari PrintJob: orderId TIDAK
// unik — customer bisa cancel/gagal lalu retry, tiap percobaan jadi row baru. Dedup cuma
// mencegah 2 job PENDING/PROCESSING/APPROVED aktif bersamaan untuk order yang sama (lihat
// POST /api/edc-jobs), bukan larangan permanen di level DB.
model EdcJob {
  id              String   @id @default(cuid())
  orderId         String
  amount          Int
  status          String   @default("PENDING") // PENDING, PROCESSING, APPROVED, REJECTED, FAILED
  approvalCode    String?
  traceNumber     String?
  cardType        String?
  pan             String? // masked PAN dari EDC (mis. 553210************5437), bukan PAN penuh
  responseCode    String?
  rawResponseData String?
  errorMessage    String?
  attempts        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

// Daily queue counter — resets at 00:00 WIB each day
model QueueCounter {
  date    String @id // Format: "2026-05-19" (WIB date)
  counter Int    @default(0)
}

// ============================================================
// LOYALTY — RAKKEN Member App (lihat PRD di project memory
// project_rakken_loyalty_app). Member App cuma konsumer API,
// tabel-tabel ini tetap dipegang backend PoS-system ini
// ("1 backend, 2 frontend").
// ============================================================

// Member App dibuat setelah login Neon Auth (Google/Email) DAN
// submit form Onboarding — bukan langsung saat login, biar nomor HP
// & sinkronisasi Olsera (search-or-create customer) sudah pasti ada.
model Member {
  id               String   @id @default(cuid())
  neonAuthUserId   String   @unique // link ke identitas login Neon Auth
  email            String   @unique
  name             String
  phone            String   @unique
  birthDate        DateTime
  olseraCustomerId String   @unique // hasil search-or-create Olsera saat onboarding

  // Kolom cache buat baca cepat — sumber kebenaran tetap PointLedger/akumulasi
  // Order, WAJIB diupdate bareng dalam satu Prisma $transaction.
  pointBalance      Int       @default(0)
  tierLevel         Int       @default(1)
  tierPeriodStart   DateTime  @default(now())
  tierPeriodSpend   Int       @default(0)
  lastTransactionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders          Order[]
  pointLedger     PointLedger[]
  claimedBenefits ClaimedBenefit[]

  @@index([tierLevel])
}

// Ledger poin (bukan cache) — sumber kebenaran saldo Poin Reward member.
// Tidak ada kolom expiry per-entry: kadaluarsa dicek dari
// Member.lastTransactionAt vs LoyaltyConfig.pointExpiryMonths.
model PointLedger {
  id        String          @id @default(cuid())
  memberId  String
  type      PointLedgerType
  amount    Int // signed: EARN/ADJUSTMENT(+) positif, REDEEM/EXPIRE negatif
  orderId   String?
  note      String?
  createdAt DateTime        @default(now())

  member Member @relation(fields: [memberId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([memberId, createdAt])
  @@index([orderId])
}

// 1 baris per tier (bukan JSON blob) biar gampang di-CRUD lewat TanStack
// Table di admin dashboard Member App.
model TierRule {
  id                      String @id @default(cuid())
  level                   Int    @unique
  name                    String
  minSpend                Int // threshold akumulasi Order.total per periode (tierPeriodDays)
  upgradeVoucherPercent   Int
  birthdayPointMultiplier Int
  weeklyDiscountPercent   Int
}

// Singleton (selalu 1 baris, id tetap "singleton") — semua angka yang bisa
// diubah admin tanpa deploy ulang.
model LoyaltyConfig {
  id                         String @id @default("singleton")
  pointRatePerRupiah         Float  @default(1) // 1 poin = Rp1 nominal transaksi
  pointExpiryMonths          Int    @default(12)
  tierPeriodDays             Int    @default(365)
  tierUpgradeClaimWindowDays Int    @default(90)
  weeklyMemberDayOfWeek      Int    @default(3) // 0=Minggu .. 6=Sabtu
}

model RewardsCatalog {
  id              String         @id @default(cuid())
  name            String
  category        RewardCategory
  pointCost       Int
  linkedProductId String? // olseraId produk, dipakai kalau category=FREE_ITEM
  stockQuota      Int?
  timesRedeemed   Int            @default(0) // dibandingkan ke stockQuota (null = tanpa batas)
  isActive        Boolean        @default(true)
  validFrom       DateTime?
  validUntil      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([isActive])
  @@index([category])
}

// Catatan klaim manual benefit tier (upgrade/ulang tahun/hari member) —
// beda dari RewardsCatalog yang inisiatif member sendiri kapan saja.
model ClaimedBenefit {
  id            String      @id @default(cuid())
  memberId      String
  type          ClaimType
  status        ClaimStatus @default(AVAILABLE)
  availableAt   DateTime    @default(now())
  expiresAt     DateTime
  claimedAt     DateTime?
  usedInOrderId String?
  createdAt     DateTime    @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, status])
}

enum OrderChannel {
  KIOSK
  MEMBER_APP
}

enum PointLedgerType {
  EARN
  REDEEM
  EXPIRE
  ADJUSTMENT
}

enum RewardCategory {
  VOUCHER
  FREE_ITEM
  MERCHANDISE
}

enum ClaimType {
  TIER_UPGRADE
  BIRTHDAY
  WEEKLY_MEMBER_DAY
}

enum ClaimStatus {
  AVAILABLE
  CLAIMED
  EXPIRED
}
