generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id               String     @id @default(cuid())
  username         String     @unique
  name             String
  passwordHash     String
  role             Role       @default(CASHIER)
  defaultStationId String?
  createdAt        DateTime   @default(now())
  orders           Order[]
  shiftLogs        ShiftLog[]
}

model Order {
  id                  String      @id
  stationId           String
  printStation        String?     // A/B/C — tablet asal order, buat routing print job ke printer yang benar
  cashierId           String
  tableNumber         String?
  queueNumber         Int?        // Daily queue number (001, 002, ...) resets at 00:00 WIB
  status              OrderStatus @default(PENDING)
  baristaStatus       OrderStatus @default(PENDING)
  kitchenStatus       OrderStatus @default(PENDING)
  total               Int
  paymentMethod       String?
  cashReceived        Int?
  changeAmount        Int?
  edcTransactionId    String?
  olseraSynced        Boolean     @default(false)
  olseraSyncedAt      DateTime?
  olseraTransactionId String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  cashier             User        @relation(fields: [cashierId], references: [id])
  items               OrderItem[]
  statusLogs          OrderStatusLog[]

  @@index([stationId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([olseraSynced])
}

// Jurnal/audit trail setiap perubahan status order (order/barista/kitchen),
// mencatat sumber perubahan supaya bisa ditelusuri kapan/dari mana/kenapa.
model OrderStatusLog {
  id          String   @id @default(cuid())
  orderId     String
  statusField String   // "order" | "barista" | "kitchen"
  fromStatus  String?  // null = entri pertama (order baru dibuat)
  toStatus    String
  source      String   // order_created | midtrans_webhook | midtrans_manual_verify |
                        // system_voucher_100 | olsera_settlement | kds_manual |
                        // olsera_webhook | system_recovery
  actorId     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@index([orderId, statusField])
  @@index([source])
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  olseraId String
  name     String
  price    Int
  quantity Int
  subtotal Int
  notes    String?
  order    Order   @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model ShiftLog {
  id          String    @id @default(cuid())
  stationId   String
  cashierId   String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  openingCash Int       @default(0)
  closingCash Int?
  totalSales  Int?
  cashier     User      @relation(fields: [cashierId], references: [id])

  @@index([stationId, startTime])
}

model ProductCache {
  olseraId    String   @id
  name        String
  description String?
  price       Int
  stock       Int
  category    String
  imageUrl    String?
  isActive    Boolean  @default(true)
  cachedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([cachedAt])
}

model OlseraSyncLog {
  id          String   @id @default(cuid())
  type        String
  status      String
  orderId     String?
  productId   String?
  itemsSynced Int?
  errorMsg    String?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([status])
}

enum Role {
  CASHIER
  MANAGER
  KITCHEN
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

// Cloud Print Queue — struk dikirim dari tablet via cloud, ditarik oleh daemon lokal
model PrintJob {
  id           String   @id @default(cuid())
  orderId      String
  payload      Json     // PrintReceiptData (orderId, items, total, dll)
  status       String   @default("PENDING") // PENDING, PRINTING, PRINTED, FAILED
  station      String?  // A/B/C — dipakai print-bridge buat routing ke printer yang benar
  attempts     Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([orderId])
}

// Daily queue counter — resets at 00:00 WIB each day
model QueueCounter {
  date     String @id  // Format: "2026-05-19" (WIB date)
  counter  Int    @default(0)
}
